// Ainabi Business — Prisma schema
// Multi-tenant (multi-business) architecture: every business-owned table
// carries a `businessId` foreign key so one account never sees another's data.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; "rhel-openssl-3.0.x" is the engine Vercel's
  // serverless Node runtime needs — without it Prisma can't find its query
  // engine binary once deployed there.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled (PgBouncer) connection — what the running app queries through.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — migrations need session-level features
  // pooled/transaction-mode connections don't reliably support. Falls back
  // to DATABASE_URL when DIRECT_URL isn't set (fine for a plain local Postgres).
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// AUTH / TENANT
// ---------------------------------------------------------------------------

enum AuthProvider {
  PASSWORD
  GOOGLE
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  phone        String?
  passwordHash String? // null for Google-only accounts
  googleId     String?      @unique
  avatarUrl    String?
  provider     AuthProvider @default(PASSWORD)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  ownedBusinesses Business[]     @relation("BusinessOwner")
  employeeOf      Employee[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Business {
  id            String   @id @default(cuid())
  name          String
  ownerId       String
  owner         User     @relation("BusinessOwner", fields: [ownerId], references: [id])
  phone         String?
  address       String?
  currency      String   @default("KGS")
  // Freeform "how to pay us by QR" text (e.g. "MBank +996 700 123 456") —
  // there's no single scannable payment-QR standard across KG banks, so
  // this is shown to the cashier/customer as read text, not parsed.
  qrPaymentInfo String?
  // Which preset the owner picked ("PHONES", "LAPTOPS", "CLOTHING", ...) —
  // see src/config/businessTemplates.ts. Only a label; the actual behaviour
  // lives in the fields/flags below, which the owner can edit freely.
  businessType  String   @default("GENERAL")
  // The business's own extra product fields (brand, RAM, size, expiry
  // date...) as ProductFieldDef[] — shape validated by settings.validator.
  productFields Json     @default("[]")
  // Serial/IMEI numbers are captured per sold unit at the POS.
  trackSerials  Boolean  @default(false)
  // Products carry a warranty period; sale items get a warrantyUntil date.
  trackWarranty Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees      Employee[]
  categories     Category[]
  products       Product[]
  customers      Customer[]
  sales          Sale[]
  stockMovements StockMovement[]
  debts          Debt[]
  expenses       Expense[]
  suppliers      Supplier[]
  supplierDebts  SupplierDebt[]

  @@map("businesses")
}

enum EmployeeRole {
  OWNER
  ADMIN
  CASHIER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

// Links a User to a Business with a role — this is both the
// "team member" record used on the Employees page and the
// authorization anchor for every request (req.businessId / req.role).
model Employee {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role        EmployeeRole   @default(CASHIER)
  status      EmployeeStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sales          Sale[]
  stockMovements StockMovement[]
  expenses       Expense[]

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// CATALOG
// ---------------------------------------------------------------------------

model Category {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())

  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("categories")
}

enum ProductUnit {
  PIECE // даана
  KG
  GRAM
  LITER
  METER
  PACK
  BOX // ящик/коробка
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model Product {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id])
  name          String
  sku           String?
  barcode       String?
  purchasePrice Decimal       @db.Decimal(12, 2)
  salePrice     Decimal       @db.Decimal(12, 2)
  quantity      Decimal       @default(0) @db.Decimal(12, 3)
  minQuantity   Decimal       @default(0) @db.Decimal(12, 3)
  unit          ProductUnit   @default(PIECE)
  imageUrl      String?
  description   String?
  // Values for the business's productFields, keyed by field key.
  attributes     Json          @default("{}")
  // Flattened attribute values, so the plain product search also matches
  // "Samsung" / "256GB" / "XL" typed into a custom field.
  attributesText String?
  // Each sold unit needs its own serial/IMEI number at the POS.
  requiresSerial Boolean       @default(false)
  warrantyMonths Int?
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([businessId])
  @@index([businessId, barcode])
  @@map("products")
}

model Supplier {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  address    String?
  createdAt  DateTime @default(now())

  stockMovements StockMovement[]
  debts          SupplierDebt[]

  @@index([businessId])
  @@map("suppliers")
}

// Amounts *we* owe a supplier for delivered goods — the mirror image of
// Debt/DebtPayment (which track what customers owe us).
model SupplierDebt {
  id              String     @id @default(cuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Supplier   @relation(fields: [supplierId], references: [id])
  totalAmount     Decimal    @db.Decimal(12, 2)
  paidAmount      Decimal    @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal    @db.Decimal(12, 2)
  status          DebtStatus @default(OPEN)
  comment         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  payments SupplierPayment[]

  @@index([businessId])
  @@index([supplierId])
  @@map("supplier_debts")
}

model SupplierPayment {
  id             String        @id @default(cuid())
  supplierDebtId String
  supplierDebt   SupplierDebt  @relation(fields: [supplierDebtId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  comment        String?
  createdAt      DateTime      @default(now())

  @@index([supplierDebtId])
  @@map("supplier_payments")
}

// ---------------------------------------------------------------------------
// CUSTOMERS
// ---------------------------------------------------------------------------

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales   Sale[]
  debts   Debt[]

  @@index([businessId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// SALES / POS
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  CARD
  QR
  DEBT
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Sale {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  costTotal     Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  createdAt     DateTime      @default(now())

  items          SaleItem[]
  debt           Debt?
  stockMovements StockMovement[]

  @@index([businessId, createdAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)
  price     Decimal @db.Decimal(12, 2)
  costPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
  // IMEI / serial numbers of the exact units sold (one per unit).
  serialNumbers String[]  @default([])
  warrantyUntil DateTime?

  @@index([saleId])
  @@index([serialNumbers], type: Gin)
  @@map("sale_items")
}

// ---------------------------------------------------------------------------
// STOCK
// ---------------------------------------------------------------------------

enum StockMovementType {
  IN // жеткирүү / киреше
  OUT // кол менен чыгаша
  SALE // сатуудан автоматтык азайуу
  ADJUSTMENT // инвентаризация оңдоо
  WRITE_OFF // списание
}

model StockMovement {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  purchasePrice Decimal?          @db.Decimal(12, 2)
  supplierId    String?
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  saleId        String?
  sale          Sale?             @relation(fields: [saleId], references: [id])
  employeeId    String?
  employee      Employee?         @relation(fields: [employeeId], references: [id])
  comment       String?
  createdAt     DateTime          @default(now())

  @@index([businessId, createdAt])
  @@index([productId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// DEBTS (карыз дептери)
// ---------------------------------------------------------------------------

enum DebtStatus {
  OPEN
  PARTIAL
  PAID
}

model Debt {
  id               String     @id @default(cuid())
  businessId       String
  business         Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer   @relation(fields: [customerId], references: [id])
  saleId           String?    @unique
  sale             Sale?      @relation(fields: [saleId], references: [id])
  totalAmount      Decimal    @db.Decimal(12, 2)
  paidAmount       Decimal    @default(0) @db.Decimal(12, 2)
  remainingAmount  Decimal    @db.Decimal(12, 2)
  status           DebtStatus @default(OPEN)
  comment          String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  payments DebtPayment[]

  @@index([businessId])
  @@index([customerId])
  @@map("debts")
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  method    PaymentMethod @default(CASH)
  comment   String?
  createdAt DateTime @default(now())

  @@index([debtId])
  @@map("debt_payments")
}

// ---------------------------------------------------------------------------
// EXPENSES
// ---------------------------------------------------------------------------

enum ExpenseCategory {
  RENT // аренда
  SALARY // айлык
  PURCHASE // товар сатып алуу
  TRANSPORT // транспорт
  UTILITIES // коммуналдык
  ADVERTISING // реклама
  OTHER // башка
}

model Expense {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   ExpenseCategory
  amount     Decimal         @db.Decimal(12, 2)
  comment    String?
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id])
  createdAt  DateTime        @default(now())

  @@index([businessId, createdAt])
  @@map("expenses")
}
