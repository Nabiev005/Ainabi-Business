// Ainabi Business — Prisma schema
// Multi-tenant (multi-business) architecture: every business-owned table
// carries a `businessId` foreign key so one account never sees another's data.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; "rhel-openssl-3.0.x" is the engine Vercel's
  // serverless Node runtime needs — without it Prisma can't find its query
  // engine binary once deployed there.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) connection — what the running app queries through.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — migrations need session-level features
  // pooled/transaction-mode connections don't reliably support. Falls back
  // to DATABASE_URL when DIRECT_URL isn't set (fine for a plain local Postgres).
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// AUTH / TENANT
// ---------------------------------------------------------------------------

enum AuthProvider {
  PASSWORD
  GOOGLE
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  phone        String?
  passwordHash String? // null for Google-only accounts
  googleId     String?      @unique
  avatarUrl    String?
  provider     AuthProvider @default(PASSWORD)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  ownedBusinesses Business[]     @relation("BusinessOwner")
  employeeOf      Employee[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Business {
  id                String   @id @default(cuid())
  name              String
  ownerId           String
  owner             User     @relation("BusinessOwner", fields: [ownerId], references: [id])
  phone             String?
  address           String?
  currency          String   @default("KGS")
  // Freeform "how to pay us by QR" text (e.g. "MBank +996 700 123 456") —
  // there's no single scannable payment-QR standard across KG banks, so
  // this is shown to the cashier/customer as read text, not parsed.
  qrPaymentInfo     String?
  // Which preset the owner picked ("PHONES", "LAPTOPS", "CLOTHING", ...) —
  // see src/config/businessTemplates.ts. Only a label; the actual behaviour
  // lives in the fields/flags below, which the owner can edit freely.
  businessType      String   @default("GENERAL")
  // The business's own extra product fields (brand, RAM, size, expiry
  // date...) as ProductFieldDef[] — shape validated by settings.validator.
  productFields     Json     @default("[]")
  // Serial/IMEI numbers are captured per sold unit at the POS.
  trackSerials      Boolean  @default(false)
  // Products carry a warranty period; sale items get a warrantyUntil date.
  trackWarranty     Boolean  @default(false)
  // Stock arrives in batches with expiry dates; sales consume the batch
  // that expires first (FEFO) and the dashboard warns before expiry.
  trackExpiry       Boolean  @default(false)
  // Repair orders module (phone / laptop / appliance workshops).
  enableRepairs     Boolean  @default(false)
  // The POS refuses to sell until the cashier has opened a cash shift.
  requireShift      Boolean  @default(false)
  // Scale-printed EAN-13 codes (prefix 2, PLU + weight) are parsed at the POS.
  weightBarcodes    Boolean  @default(false)
  // Products can be flagged "prescription only"; the POS asks to confirm.
  checkPrescription Boolean  @default(false)
  // Per-business running numbers for human-friendly document numbers.
  saleCounter       Int      @default(0)
  receiptCounter    Int      @default(0)
  repairCounter     Int      @default(0)
  inventoryCounter  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employees        Employee[]
  categories       Category[]
  products         Product[]
  customers        Customer[]
  sales            Sale[]
  stockMovements   StockMovement[]
  debts            Debt[]
  expenses         Expense[]
  suppliers        Supplier[]
  supplierDebts    SupplierDebt[]
  locations        Location[]
  variantGroups    ProductVariantGroup[]
  productPackages  ProductPackage[]
  productAnalogs   ProductAnalog[]
  productSerials   ProductSerial[]
  productBatches   ProductBatch[]
  purchaseReceipts PurchaseReceipt[]
  inventoryCounts  InventoryCount[]
  stockTransfers   StockTransfer[]
  saleReturns      SaleReturn[]
  repairOrders     RepairOrder[]
  cashShifts       CashShift[]

  @@map("businesses")
}

enum EmployeeRole {
  OWNER
  ADMIN
  CASHIER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

// Links a User to a Business with a role — this is both the
// "team member" record used on the Employees page and the
// authorization anchor for every request (req.businessId / req.role).
model Employee {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role        EmployeeRole   @default(CASHIER)
  status      EmployeeStatus @default(ACTIVE)
  lastLoginAt DateTime?
  // Branch / warehouse this employee works at (null = the default one).
  locationId  String?
  location    Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sales            Sale[]
  stockMovements   StockMovement[]
  expenses         Expense[]
  purchaseReceipts PurchaseReceipt[]
  inventoryCounts  InventoryCount[]
  stockTransfers   StockTransfer[]
  saleReturns      SaleReturn[]
  repairOrders     RepairOrder[]
  cashShifts       CashShift[]

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// CATALOG
// ---------------------------------------------------------------------------

model Category {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())

  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("categories")
}

enum ProductUnit {
  PIECE // даана
  KG
  GRAM
  LITER
  METER
  PACK
  BOX // ящик/коробка
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model Product {
  id                   String               @id @default(cuid())
  businessId           String
  business             Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId           String?
  category             Category?            @relation(fields: [categoryId], references: [id])
  name                 String
  sku                  String?
  barcode              String?
  purchasePrice        Decimal              @db.Decimal(12, 2)
  salePrice            Decimal              @db.Decimal(12, 2)
  quantity             Decimal              @default(0) @db.Decimal(12, 3)
  minQuantity          Decimal              @default(0) @db.Decimal(12, 3)
  unit                 ProductUnit          @default(PIECE)
  imageUrl             String?
  description          String?
  // Values for the business's productFields, keyed by field key.
  attributes           Json                 @default("{}")
  // Flattened attribute values, so the plain product search also matches
  // "Samsung" / "256GB" / "XL" typed into a custom field.
  attributesText       String?
  // Each sold unit needs its own serial/IMEI number at the POS.
  requiresSerial       Boolean              @default(false)
  warrantyMonths       Int?
  // Size/colour variants: every variant is its own Product (own stock,
  // barcode, price) linked to a group; variantLabel is e.g. "M / Кара".
  variantGroupId       String?
  variantGroup         ProductVariantGroup? @relation(fields: [variantGroupId], references: [id], onDelete: SetNull)
  variantLabel         String?
  // 5-digit PLU the shop's scale prints into weight barcodes.
  scaleCode            String?
  wholesalePrice       Decimal?             @db.Decimal(12, 2)
  prescriptionRequired Boolean              @default(false)
  status               ProductStatus        @default(ACTIVE)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  saleItems      SaleItem[]
  stockMovements StockMovement[]
  stocks         ProductStock[]
  packages       ProductPackage[]
  analogs        ProductAnalog[]       @relation("ProductAnalogs")
  analogOf       ProductAnalog[]       @relation("AnalogTarget")
  serials        ProductSerial[]
  batches        ProductBatch[]
  receiptItems   PurchaseReceiptItem[]
  countItems     InventoryCountItem[]
  transferItems  StockTransferItem[]
  returnItems    SaleReturnItem[]

  @@index([businessId])
  @@index([businessId, barcode])
  @@index([businessId, scaleCode])
  @@map("products")
}

model Supplier {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  address    String?
  createdAt  DateTime @default(now())

  stockMovements StockMovement[]
  debts          SupplierDebt[]
  receipts       PurchaseReceipt[]

  @@index([businessId])
  @@map("suppliers")
}

// Amounts *we* owe a supplier for delivered goods — the mirror image of
// Debt/DebtPayment (which track what customers owe us).
model SupplierDebt {
  id              String     @id @default(cuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Supplier   @relation(fields: [supplierId], references: [id])
  totalAmount     Decimal    @db.Decimal(12, 2)
  paidAmount      Decimal    @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal    @db.Decimal(12, 2)
  status          DebtStatus @default(OPEN)
  comment         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  payments SupplierPayment[]

  @@index([businessId])
  @@index([supplierId])
  @@map("supplier_debts")
}

model SupplierPayment {
  id             String        @id @default(cuid())
  supplierDebtId String
  supplierDebt   SupplierDebt  @relation(fields: [supplierDebtId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  comment        String?
  createdAt      DateTime      @default(now())

  @@index([supplierDebtId])
  @@map("supplier_payments")
}

// ---------------------------------------------------------------------------
// CUSTOMERS
// ---------------------------------------------------------------------------

model Customer {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  notes       String?
  // Gets the wholesale price at the POS by default.
  isWholesale Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales        Sale[]
  debts        Debt[]
  receipts     PurchaseReceipt[]
  repairOrders RepairOrder[]

  @@index([businessId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// SALES / POS
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  CARD
  QR
  DEBT
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Sale {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  costTotal     Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  // Per-business running number printed on the receipt.
  number        Int?
  locationId    String?
  shiftId       String?
  priceLevel    String        @default("RETAIL")
  // Sum of all returns against this sale (returns themselves are
  // subtracted from revenue on the day they happen, see report.service).
  returnedTotal Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())

  items          SaleItem[]
  debt           Debt?
  stockMovements StockMovement[]
  returns        SaleReturn[]

  @@index([businessId, createdAt])
  @@map("sales")
}

model SaleItem {
  id               String    @id @default(cuid())
  saleId           String
  sale             Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  quantity         Decimal   @db.Decimal(12, 3)
  price            Decimal   @db.Decimal(12, 2)
  costPrice        Decimal   @db.Decimal(12, 2)
  total            Decimal   @db.Decimal(12, 2)
  // IMEI / serial numbers of the exact units sold (one per unit).
  serialNumbers    String[]  @default([])
  warrantyUntil    DateTime?
  returnedQuantity Decimal   @default(0) @db.Decimal(12, 3)
  // Sold by package ("Мешок", "Пластинка"): quantity stays in base units,
  // price is per package, packageQuantity is how many packages.
  packageName      String?
  packageQuantity  Decimal?  @db.Decimal(12, 3)

  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([serialNumbers], type: Gin)
  @@map("sale_items")
}

// ---------------------------------------------------------------------------
// STOCK
// ---------------------------------------------------------------------------

enum StockMovementType {
  IN // жеткирүү / киреше
  OUT // кол менен чыгаша
  SALE // сатуудан автоматтык азайуу
  ADJUSTMENT // инвентаризация оңдоо (quantity is signed)
  WRITE_OFF // списание
  RETURN // кардар кайтарган товар
  TRANSFER // филиалдар ортосунда которуу
}

model StockMovement {
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId        String
  product          Product           @relation(fields: [productId], references: [id])
  type             StockMovementType
  quantity         Decimal           @db.Decimal(12, 3)
  purchasePrice    Decimal?          @db.Decimal(12, 2)
  supplierId       String?
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  saleId           String?
  sale             Sale?             @relation(fields: [saleId], references: [id])
  employeeId       String?
  employee         Employee?         @relation(fields: [employeeId], references: [id])
  comment          String?
  locationId       String?
  toLocationId     String?
  receiptId        String?
  returnId         String?
  transferId       String?
  inventoryCountId String?
  createdAt        DateTime          @default(now())

  @@index([businessId, createdAt])
  @@index([productId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// DEBTS (карыз дептери)
// ---------------------------------------------------------------------------

enum DebtStatus {
  OPEN
  PARTIAL
  PAID
}

model Debt {
  id              String     @id @default(cuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer   @relation(fields: [customerId], references: [id])
  saleId          String?    @unique
  sale            Sale?      @relation(fields: [saleId], references: [id])
  totalAmount     Decimal    @db.Decimal(12, 2)
  paidAmount      Decimal    @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal    @db.Decimal(12, 2)
  status          DebtStatus @default(OPEN)
  comment         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  payments DebtPayment[]

  @@index([businessId])
  @@index([customerId])
  @@map("debts")
}

model DebtPayment {
  id        String        @id @default(cuid())
  shiftId   String?
  debtId    String
  debt      Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(CASH)
  comment   String?
  createdAt DateTime      @default(now())

  @@index([debtId])
  @@map("debt_payments")
}

// ---------------------------------------------------------------------------
// EXPENSES
// ---------------------------------------------------------------------------

enum ExpenseCategory {
  RENT // аренда
  SALARY // айлык
  PURCHASE // товар сатып алуу
  TRANSPORT // транспорт
  UTILITIES // коммуналдык
  ADVERTISING // реклама
  OTHER // башка
}

model Expense {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   ExpenseCategory
  amount     Decimal         @db.Decimal(12, 2)
  comment    String?
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id])
  createdAt  DateTime        @default(now())

  @@index([businessId, createdAt])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// LOCATIONS (филиалдар / складдар)
// ---------------------------------------------------------------------------

model Location {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  isDefault  Boolean  @default(false)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  stocks    ProductStock[]
  employees Employee[]

  @@index([businessId])
  @@map("locations")
}

// Per-location stock. Product.quantity stays the business-wide total and
// is always changed together with these rows (see utils/stockLedger.ts).
model ProductStock {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Decimal  @default(0) @db.Decimal(12, 3)

  @@unique([productId, locationId])
  @@index([locationId])
  @@map("product_stocks")
}

model StockTransfer {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromLocationId String
  toLocationId   String
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  comment        String?
  createdAt      DateTime @default(now())

  items StockTransferItem[]

  @@index([businessId, createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Decimal       @db.Decimal(12, 3)

  @@index([transferId])
  @@map("stock_transfer_items")
}

// ---------------------------------------------------------------------------
// VARIANTS, PACKAGES, ANALOGS
// ---------------------------------------------------------------------------

model ProductVariantGroup {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  // [{ name: "Өлчөм", values: ["S","M","L"] }, { name: "Түс", values: [...] }]
  dimensions Json     @default("[]")
  createdAt  DateTime @default(now())

  products Product[]

  @@index([businessId])
  @@map("product_variant_groups")
}

// Alternative selling unit: "Мешок" = 50 кг, "Пластинка" = 0.1 коробка.
model ProductPackage {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  // How many base units one package holds.
  factor     Decimal  @db.Decimal(12, 3)
  barcode    String?
  salePrice  Decimal? @db.Decimal(12, 2)

  @@index([productId])
  @@index([businessId, barcode])
  @@map("product_packages")
}

// Interchangeable products (same OEM part from another maker). Stored in
// both directions so either side finds the other with one query.
model ProductAnalog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation("ProductAnalogs", fields: [productId], references: [id], onDelete: Cascade)
  analogId   String
  analog     Product  @relation("AnalogTarget", fields: [analogId], references: [id], onDelete: Cascade)

  @@unique([productId, analogId])
  @@map("product_analogs")
}

// ---------------------------------------------------------------------------
// SERIALS & BATCHES
// ---------------------------------------------------------------------------

enum SerialStatus {
  IN_STOCK
  SOLD
}

model ProductSerial {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  serial     String
  status     SerialStatus @default(IN_STOCK)
  receiptId  String?
  saleId     String?
  createdAt  DateTime     @default(now())
  soldAt     DateTime?

  @@unique([businessId, serial])
  @@index([productId, status])
  @@map("product_serials")
}

model ProductBatch {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber     String?
  expiryDate      DateTime? @db.Date
  initialQuantity Decimal   @db.Decimal(12, 3)
  // What's left of this batch; sales consume the earliest expiry first.
  quantity        Decimal   @db.Decimal(12, 3)
  receiptId       String?
  createdAt       DateTime  @default(now())

  @@index([businessId, expiryDate])
  @@index([productId])
  @@map("product_batches")
}

// ---------------------------------------------------------------------------
// PURCHASE RECEIPTS (кирим накладнойу), incl. trade-in from customers
// ---------------------------------------------------------------------------

enum ReceiptType {
  PURCHASE
  TRADE_IN
}

model PurchaseReceipt {
  id             String         @id @default(cuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number         Int
  type           ReceiptType    @default(PURCHASE)
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id])
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id])
  // Trade-in seller who isn't a saved customer.
  sellerName     String?
  locationId     String
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id])
  shiftId        String?
  // Supplier's own invoice number.
  docNumber      String?
  total          Decimal        @db.Decimal(12, 2)
  paidAmount     Decimal        @default(0) @db.Decimal(12, 2)
  paymentMethod  PaymentMethod?
  supplierDebtId String?
  comment        String?
  createdAt      DateTime       @default(now())

  items PurchaseReceiptItem[]

  @@index([businessId, createdAt])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id            String          @id @default(cuid())
  receiptId     String
  receipt       PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  quantity      Decimal         @db.Decimal(12, 3)
  purchasePrice Decimal         @db.Decimal(12, 2)
  total         Decimal         @db.Decimal(12, 2)
  batchNumber   String?
  expiryDate    DateTime?       @db.Date
  serialNumbers String[]        @default([])

  @@index([receiptId])
  @@map("purchase_receipt_items")
}

// ---------------------------------------------------------------------------
// INVENTORY COUNTS (инвентаризация)
// ---------------------------------------------------------------------------

model InventoryCount {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number        Int
  locationId    String
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  comment       String?
  itemsCount    Int      @default(0)
  // Cost value of missing / extra goods found by the count.
  shortageValue Decimal  @default(0) @db.Decimal(12, 2)
  surplusValue  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  items InventoryCountItem[]

  @@index([businessId, createdAt])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id          String         @id @default(cuid())
  countId     String
  count       InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  expectedQty Decimal        @db.Decimal(12, 3)
  countedQty  Decimal        @db.Decimal(12, 3)
  difference  Decimal        @db.Decimal(12, 3)
  costPrice   Decimal        @db.Decimal(12, 2)

  @@index([countId])
  @@map("inventory_count_items")
}

// ---------------------------------------------------------------------------
// RETURNS (возврат)
// ---------------------------------------------------------------------------

model SaleReturn {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleId       String
  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id])
  locationId   String?
  shiftId      String?
  total        Decimal       @db.Decimal(12, 2)
  costTotal    Decimal       @db.Decimal(12, 2)
  // DEBT = the refund was taken off the customer's open debt instead.
  refundMethod PaymentMethod
  reason       String?
  createdAt    DateTime      @default(now())

  items SaleReturnItem[]

  @@index([businessId, createdAt])
  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id            String     @id @default(cuid())
  returnId      String
  return        SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId    String
  saleItem      SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  productId     String
  product       Product    @relation(fields: [productId], references: [id])
  quantity      Decimal    @db.Decimal(12, 3)
  total         Decimal    @db.Decimal(12, 2)
  costTotal     Decimal    @db.Decimal(12, 2)
  serialNumbers String[]   @default([])

  @@index([returnId])
  @@map("sale_return_items")
}

// ---------------------------------------------------------------------------
// REPAIR ORDERS (ремонт)
// ---------------------------------------------------------------------------

enum RepairStatus {
  RECEIVED
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

model RepairOrder {
  id                String         @id @default(cuid())
  businessId        String
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number            Int
  customerId        String?
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String
  customerPhone     String?
  device            String
  serial            String?
  problem           String
  notes             String?
  estimatedPrice    Decimal?       @db.Decimal(12, 2)
  // Taken in cash when the device is accepted.
  prepayment        Decimal        @default(0) @db.Decimal(12, 2)
  finalPrice        Decimal?       @db.Decimal(12, 2)
  paymentMethod     PaymentMethod?
  status            RepairStatus   @default(RECEIVED)
  employeeId        String
  employee          Employee       @relation(fields: [employeeId], references: [id])
  locationId        String?
  prepaymentShiftId String?
  deliveryShiftId   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deliveredAt       DateTime?

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@map("repair_orders")
}

// ---------------------------------------------------------------------------
// CASH SHIFTS (касса сменасы)
// ---------------------------------------------------------------------------

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  IN
  OUT
}

model CashShift {
  id           String      @id @default(cuid())
  businessId   String
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId   String?
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id])
  status       ShiftStatus @default(OPEN)
  openingCash  Decimal     @db.Decimal(12, 2)
  expectedCash Decimal?    @db.Decimal(12, 2)
  countedCash  Decimal?    @db.Decimal(12, 2)
  difference   Decimal?    @db.Decimal(12, 2)
  note         String?
  openedAt     DateTime    @default(now())
  closedAt     DateTime?

  movements CashMovement[]

  @@index([businessId, openedAt])
  @@index([employeeId, status])
  @@map("cash_shifts")
}

// Cash put into / taken out of the drawer outside of sales (change fund,
// collection by the owner, paying a courier...).
model CashMovement {
  id        String           @id @default(cuid())
  shiftId   String
  shift     CashShift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type      CashMovementType
  amount    Decimal          @db.Decimal(12, 2)
  reason    String?
  createdAt DateTime         @default(now())

  @@index([shiftId])
  @@map("cash_movements")
}
