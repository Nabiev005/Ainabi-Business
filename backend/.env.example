# Server
PORT=4000
NODE_ENV=development

# Frontend origin(s) allowed to call this API (CORS + cookie allow-list).
# Comma-separate multiple origins, e.g. a prod domain + Vercel preview URL.
# No trailing slash.
CLIENT_URL=http://localhost:5173

# Set to "true" ONLY if the frontend and backend are on different domains
# in production (e.g. Vercel frontend + Railway backend). Leave unset for
# local dev or same-domain deployments.
COOKIE_CROSS_SITE=false

# Database (PostgreSQL) — in production, use your managed provider's
# connection string (Railway/Neon/Supabase all give you one; keep sslmode=require if offered).
# On Neon specifically: DATABASE_URL = the pooled ("-pooler") connection string
# (what the running app queries through), DIRECT_URL = the same string with
# "-pooler" removed from the hostname (Prisma migrations need a direct,
# unpooled connection). Locally, both can just be the same value.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ainabi_business?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ainabi_business?schema=public"

# JWT — REQUIRED, no default. Generate real random secrets before deploying:
#   openssl rand -base64 48
# Never reuse the placeholders below outside local dev — the app refuses to
# boot in production if it detects a placeholder or a secret under 32 chars.
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google Sign-In (OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials)
# Must match the frontend's VITE_GOOGLE_CLIENT_ID — it's the same Client ID on both sides.
GOOGLE_CLIENT_ID=

# Subscriptions — the platform owner's account email(s) (comma-separated).
# Those accounts get the hidden "Platform" panel where payments are recorded
# and subscriptions extended. Register that account BEFORE going live.
PLATFORM_ADMIN_EMAILS=ajbeknabiev90@gmail.com
# Payment details shown to customers on the "Subscription" page.
PLATFORM_PAYMENT_INFO="O!Деньги / MBank: +996 702 952 200 (Айбек Н.)"
# Payment QR image (file in frontend/public or a full URL).
PLATFORM_PAYMENT_QR=/payment-qr.jpg
# WhatsApp number (digits only) customers send the payment receipt to.
PLATFORM_SUPPORT_WHATSAPP=996702952200
